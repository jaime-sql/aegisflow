{
  "name": "aegisflow-path",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "account_id": "8a8c9483df8e8a2a9adec437a0994fe4",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BASE_PATH": "/aegisflow",
    "PUBLIC_ORIGIN": "https://cortexmatter.com",
    // OpenNext SSR fetches request.url. Binding to the inbound Host
    // (cortexmatter.com or this Worker's workers.dev) re-enters this
    // Worker and Cloudflare returns Error 1019.
    "AEGISFLOW_ORIGIN": "https://aegisflow.jaime-8a8.workers.dev"
  },
  "services": [
    {
      "binding": "AEGISFLOW",
      "service": "aegisflow"
    }
  ],
  "routes": [
    {
      "pattern": "cortexmatter.com/aegisflow",
      "zone_name": "cortexmatter.com"
    },
    {
      "pattern": "cortexmatter.com/aegisflow/*",
      "zone_name": "cortexmatter.com"
    }
  ]
}
