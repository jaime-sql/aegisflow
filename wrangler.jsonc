{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aegisflow",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "8a8c9483df8e8a2a9adec437a0994fe4",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom worker imports `@/lib/...` from src (OpenNext fetch is pre-bundled).
  "alias": {
    "@": "./src"
  },
  "tsconfig": "./tsconfig.json",
  // Picker-region WeatherNext cache. Cron ~8 min × 2 bboxes ≈ 12–16 queries/hour.
  "triggers": {
    "crons": ["*/8 * * * *"]
  },
  // Binding only — Cloudflare Prod runs scripts/ensure-wind-cache-kv.mjs to
  // create/look up namespace `aegisflow-WIND_CACHE` and write `id` before deploy.
  // Local `wrangler dev` simulates KV without a remote id.
  // Jaime one-time if the API token cannot create KV:
  //   npx wrangler kv namespace create WIND_CACHE
  "kv_namespaces": [
    {
      "binding": "WIND_CACHE"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aegisflow"
    }
  ],
  // Non-secret runtime env. OpenNext middleware / RSC read process.env here;
  // next.config.ts inlines the same values at build. Clerk keys and ingest
  // secrets (FIRMS_MAP_KEY, GCP_SA_JSON) are Worker secrets — see
  // cloudflare-prod.yml — not vars.
  "vars": {
    "NEXTJS_ENV": "production",
    "CLOUDFLARE_PROD": "true",
    "BASE_PATH": "/aegisflow",
    "NEXT_PUBLIC_BASE_PATH": "/aegisflow",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/aegisflow/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/aegisflow/sign-up",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": "/aegisflow/ops",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL": "/aegisflow/ops",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL": "/aegisflow/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/aegisflow/ops",
    "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/aegisflow/ops",
    "GCP_PROJECT_ID": "aegisflow-ieee-quest",
    "WEATHERNEXT_BQ_DATASET": "weathernext",
    "WEATHERNEXT_BQ_TABLE": "weathernext_3_0_0_0p1deg",
    "WEATHERNEXT_BQ_LOCATION": "US"
  }
}
