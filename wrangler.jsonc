{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aegisflow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "8a8c9483df8e8a2a9adec437a0994fe4",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aegisflow"
    }
  ],
  // Non-secret runtime env. OpenNext middleware / RSC read process.env here;
  // next.config.ts inlines the same values at build. Clerk keys are Worker
  // secrets (see cloudflare-prod.yml), not vars.
  "vars": {
    "NEXTJS_ENV": "production",
    "CLOUDFLARE_PROD": "true",
    "BASE_PATH": "/aegisflow",
    "NEXT_PUBLIC_BASE_PATH": "/aegisflow",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/aegisflow/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/aegisflow/sign-up",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": "/aegisflow/ops",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL": "/aegisflow/ops",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/aegisflow/ops",
    "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/aegisflow/ops"
  }
}
