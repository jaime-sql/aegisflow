# AegisFlow Stage 2 — copy to .env.local (never commit secrets)

# --- Clerk (Ops login + RBAC) ---
# Create an application at https://dashboard.clerk.com
# Then set publicMetadata.role to "manager" or "viewer" on each user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local / `next dev` (no basePath):
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/ops
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/ops
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/ops
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/ops

# Cloudflare prod (`BASE_PATH=/aegisflow` or `CLOUDFLARE_PROD=true`) inlines these
# via next.config.ts. Also set the same paths in Clerk Dashboard for
# https://cortexmatter.com/aegisflow — see README "Clerk on /aegisflow".
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/aegisflow/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/aegisflow/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/aegisflow/ops
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/aegisflow/ops
# NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/aegisflow/sign-in
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/aegisflow/ops
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/aegisflow/ops

# When Clerk keys are empty, the app uses a DEV bypass (NON-PROD banner).
# Optional: force Viewer in bypass mode (default is manager).
# AEGISFLOW_DEV_ROLE=viewer

# --- Path hosting (set by CI for Cloudflare prod; leave unset locally) ---
# BASE_PATH=/aegisflow
# CLOUDFLARE_PROD=true

# --- NASA FIRMS ---
# https://firms.modaps.eosdis.nasa.gov/api/area/
# If unset, Ops remaps Cascade fixture hotspots into the selected region bbox
# (default: El Salvador / WUI). See docs/regions.md.
# Quiet live days (key set, 0 detections) show an empty map + "0 LIVE" chip —
# not the demo fixture. Fixture is only for missing key / pull failure.
FIRMS_MAP_KEY=

# Optional product override. Default is multi-sensor NRT:
# VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
# FIRMS_PRODUCT=VIIRS_SNPP_NRT
# Optional day range 1–5 (default 2)
# FIRMS_DAY_RANGE=2
# AEGISFLOW_USE_FIRMS_FIXTURE=true
# Ops also proxies FIRMS WMS tiles at /api/ops/firms-wms (MAP_KEY stays server-side)
# and polls /api/ops/ingest-refresh every 3 minutes (FIRMS+wind only, no LLM).

# --- WeatherNext (GCP project aegisflow-ieee-quest) ---
# Real-time overlay is Experimental. Historic is CC BY 4.0.
# Prefer GCP_SA_JSON (raw service-account JSON) for Cloudflare Workers.
# Local Node may use GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json instead.
# Never commit the JSON. See docs/weathernext.md
GCP_SA_JSON=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=aegisflow-ieee-quest
WEATHERNEXT_BQ_DATASET=weathernext
WEATHERNEXT_BQ_TABLE=weathernext_3_0_0_0p1deg
WEATHERNEXT_BQ_LOCATION=US
# AEGISFLOW_USE_WEATHERNEXT_FIXTURE=true
# AEGISFLOW_LIVE_WEATHERNEXT=false
# Cloudflare Worker binds KV WIND_CACHE (keys wind:el-salvador / wind:cascade).
# Cron */8 * * * * refreshes both picker regions (90s BigQuery budget).
# Ops reads cache only. Signed-in GET /api/ops/wind-cache-refresh is a one-shot fill.
# Local next dev skips KV. See docs/weathernext.md

# --- LLM router (OpenAI primary / DeepSeek backup). Empty → fixture agents. ---
# Live calls happen when a key is set (unless AEGISFLOW_LIVE_LLM=false).
# See docs/agents.md. Never commit real keys.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# AEGISFLOW_LIVE_LLM=false
# AEGISFLOW_USE_AGENT_FIXTURE=true

# --- Modal worker (preferred). Empty MODAL_ENDPOINT → local LLM or fixture. ---
# modal secret create aegisflow-llm OPENAI_API_KEY=... DEEPSEEK_API_KEY=...
# modal deploy workers/modal_stub.py
# Then paste the run_agent URL and proxy-token pair:
MODAL_ENDPOINT=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- ElevenLabs Brief aloud (Manager-only, exec summary) ---
# Expire-first: Jaime’s ElevenLabs credits. Cache last clip per eventId in WIND_CACHE (key tts:<eventId>).
# Empty key → quiet SIM / muted control. Ops never crashes. Viewer never sees the control.
# Default voice is ElevenLabs premade Rachel (21m00Tcm4TlvDq8ikWAM) — Jaime did not pick a voice.
# Override with ELEVENLABS_VOICE_ID from https://elevenlabs.io/app/voice-library (Worker secret in prod).
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Optional later ingest ---
TAVILY_API_KEY=
APIFY_API_TOKEN=
